# Pin this to a reviewed SearXNG release before production use.
SEARXNG_VERSION=2026.10.7-6671d89be

# Public hostname configured in the Cloudflare Tunnel dashboard.
SEARXNG_BASE_URL=https://search.example.com/

# Create a remotely-managed tunnel and paste its connector token here.
CLOUDFLARE_TUNNEL_TOKEN=replace-with-your-tunnel-token

# Generate locally with: openssl rand -hex 32
SEARXNG_SECRET=replace-with-a-random-64-character-hex-value

# Caddy protects the public search endpoint with HTTP Basic Auth.
SEARXNG_AUTH_USERNAME=api
# Generate a bcrypt hash with the command in README.md.
SEARXNG_AUTH_PASSWORD_HASH=replace-with-caddy-bcrypt-hash
